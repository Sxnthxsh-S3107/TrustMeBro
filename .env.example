# ===============================================
# Voice Intake + NLP Environment Configuration
# ===============================================

# OpenAI API Key for Whisper Speech-to-Text
# Leave blank to use Mock ASR in development/testing mode
OPENAI_API_KEY=

# ASR Backend: "whisper" or "mock" (defaults to "whisper" if OPENAI_API_KEY set, else "mock")
ASR_BACKEND=mock

# Server Port
VOICE_INTAKE_PORT=5000

# CORS Allowed Origins (comma-separated or * for wildcard development)
CORS_ORIGINS=*

DATABASE_URL="your_database_url_here"
GROQ_API_KEY="your_groq_api_key_here"

# ===============================================
# Tamil TTS — Google Cloud Text-to-Speech
# ===============================================

# Set TTS_PROVIDER to choose the Tamil TTS engine:
#   gtts   — Google Translate TTS (DEFAULT, no credentials, real Tamil audio)
#   google — Google Cloud TTS (production quality, requires GOOGLE_APPLICATION_CREDENTIALS)
#   mock   — Silent WAV, used in CI/offline environments only
TTS_PROVIDER=gtts

# Google Cloud project that has the Text-to-Speech API enabled.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Absolute path to the service-account JSON key file.
# Download from: GCP Console → IAM & Admin → Service Accounts → Keys
# Required role: roles/texttospeech.user  (or "Cloud Text-to-Speech User")
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
