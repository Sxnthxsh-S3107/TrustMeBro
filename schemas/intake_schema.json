    "duration": { "type": ["string", "null"] },
    "severity": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "stridor": { "type": ["boolean", "string", "null"] },
    "airway_swelling": { "type": ["boolean", "string", "null"] },
    "facial_or_tongue_swelling": { "type": ["boolean", "string", "null"] },
    "severe_respiratory_distress": { "type": ["boolean", "string", "null"] },
    "central_cyanosis": { "type": ["boolean", "string", "null"] },
